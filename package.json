{
  "name": "lily-coach",
  "private": true,
  "type": "module",
  "description": "lily.coach: static site in src/, Cloudflare Pages Functions in functions/ and server/",
  "scripts": {
    "dev": "wrangler pages dev --port 8788",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:preview": "wrangler d1 migrations apply lily-coach-preview --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.1",
    "@cloudflare/workers-types": "^5.20261124.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.167.0"
  }
}
